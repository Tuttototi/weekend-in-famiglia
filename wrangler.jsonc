{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weekend-in-famiglia",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*", "/cloudflare-config.js"]
  },
  "d1_databases": [
    {
      "binding": "CALENDAR_DB",
      "database_name": "weekend-in-famiglia",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
