{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weekend-in-famiglia",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*", "/cloudflare-config.js"]
  },
  "d1_databases": [
    {
      "binding": "CALENDAR_DB",
      "database_name": "weekend-in-famiglia",
      "database_id": "52211d1b-2cb4-4bcd-8538-70d05cff05e4",
      "migrations_dir": "migrations"
    }
  ]
}
